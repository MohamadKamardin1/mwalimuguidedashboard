{
  "name": "zanzibar-dashboards",
  "version": "0.1.0",
  "description": "Zanzibar School AI - dashboard for AI-assisted mathematics exam marking.",
  "license": "MIT",
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider CI=false vue-cli-service build && gulp licenses && cp dist/index.html dist/404.html",
    "lint": "vue-cli-service lint",
    "build:tailwind": "tailwind build src/assets/styles/index.css -o src/assets/styles/tailwind.css",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm run build:tailwind && npm run serve",
    "publish": "gh-pages -d dist",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@popperjs/core": "2.9.1",
    "@tailwindcss/forms": "0.2.1",
    "@vue/compiler-sfc": "3.5.43",
    "chart.js": "2.9.4",
    "core-js": "3.9.1",
    "github-pages": "^3.0.2",
    "gulp": "4.0.2",
    "gulp-append-prepend": "1.0.8",
    "katex": "^0.18.9",
    "papaparse": "^5.7.0",
    "pinia": "2.3.1",
    "tailwindcss": "2.0.4",
    "vue": "3.5.43",
    "vue-router": "4.0.5"
  },
  "devDependencies": {
    "@babel/core": "7.13.10",
    "@babel/eslint-parser": "7.13.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/cli-plugin-babel": "5.0.9",
    "@vue/cli-plugin-eslint": "5.0.9",
    "@vue/cli-service": "5.0.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "10.2.5",
    "cross-env": "^7.0.3",
    "eslint": "7.22.0",
    "eslint-plugin-vue": "7.7.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "8.4.39",
    "vitest": "^1.6.1",
    "vue-template-compiler": "2.6.12",
    "webpack": "5.107.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
