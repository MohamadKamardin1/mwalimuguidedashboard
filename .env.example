# Copy to .env to point the app somewhere other than the deployed backend.
#
# The default, compiled into the build, is the live API:
#   https://mwalimuguide.mohamadkamardin.space/graphql
# so a build with no .env at all still works -- which is what the deployed site
# needs. Set this only to override it, for example to develop against a backend
# running on your own machine:
VUE_APP_GRAPHQL_URL=http://localhost:8000/graphql
